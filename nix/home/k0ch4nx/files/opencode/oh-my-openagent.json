            "fallback_models": [
                "nvidia/moonshotai/kimi-k2.6",
                "openrouter/free"
            ]
        }
    },
    "background_task": {
        "defaultConcurrency": 5,
        "providerConcurrency": {
            "openai": 2,
            "opencode-go": 3,
            "nvidia": 2,
            "openrouter": 2
        },
        "modelConcurrency": {
            "opencode-go/kimi-k2.7-code": 1,
            "opencode-go/kimi-k3": 1
        }
    },
    "runtime_fallback": {
        "enabled": true,
        "retry_on_errors": [
            400,
            401,
            403,
            404,
            429,
            500,
            502,
            503,
            504
        ],
        "max_fallback_attempts": 4,
        "cooldown_seconds": 15,
        "timeout_seconds": 15,
        "notify_on_fallback": true
    },
    "telemetry": false
}
