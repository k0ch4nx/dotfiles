{
    "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
    "agents": {
        "sisyphus": {
            "model": "opencode-go/kimi-k2.7-code",
            "fallback_models": [
                "nvidia/moonshotai/kimi-k2.6"
            ],
            "ultrawork": {
                "model": "opencode-go/kimi-k3"
            }
        },
        "hephaestus": {
            "model": "openai/gpt-5.6-sol",
            "fallback_models": [
                "nvidia/deepseek-ai/deepseek-v4-pro"
            ]
        },
        "oracle": {
            "model": "openai/gpt-5.6-sol",
            "fallback_models": [
                "nvidia/z-ai/glm-5.2"
            ]
        },
        "librarian": {
            "model": "openai/gpt-5.4-mini-fast",
            "fallback_models": [
                "nvidia/minimaxai/minimax-m3"
            ]
        },
        "explore": {
            "model": "openai/gpt-5.4-mini-fast",
            "fallback_models": [
                "nvidia/minimaxai/minimax-m3"
            ]
        },
        "multimodal-looker": {
            "model": "openai/gpt-5.6-sol",
            "fallback_models": [
                "nvidia/moonshotai/kimi-k2.6"
            ]
        },
        "prometheus": {
            "model": "opencode-go/kimi-k2.7-code",
            "fallback_models": [
                "nvidia/moonshotai/kimi-k2.6"
            ]
        },
        "metis": {
            "model": "opencode-go/kimi-k2.7",
            "fallback_models": [
                "nvidia/moonshotai/kimi-k2.6"
            ]
        },
        "momus": {
            "model": "openai/gpt-5.6-terra",
            "fallback_models": [
                "nvidia/z-ai/glm-5.2"
            ]
        },
        "atlas": {
            "model": "opencode-go/kimi-k2.7-code",
            "fallback_models": [
                "nvidia/minimaxai/minimax-m3"
            ]
        },
        "sisyphus-junior": {
            "model": "opencode-go/kimi-k2.7-code",
            "fallback_models": [
                "nvidia/minimaxai/minimax-m3"
            ]
        }
    },
    "categories": {
        "visual-engineering": {
            "model": "opencode-go/qwen3.7-plus",
            "fallback_models": [
                "nvidia/moonshotai/kimi-k2.6"
            ]
        },
        "ultrabrain": {
            "model": "openai/gpt-5.6-sol",
            "fallback_models": [
                "nvidia/z-ai/glm-5.2"
            ]
        },
        "deep": {
            "model": "openai/gpt-5.6-terra",
            "fallback_models": [
                "nvidia/moonshotai/kimi-k2.6"
            ]
        },
        "artistry": {
            "model": "opencode-go/qwen3.7-plus",
            "fallback_models": [
                "nvidia/moonshotai/kimi-k2.6"
            ]
        },
        "quick": {
            "model": "openai/gpt-5.4-mini",
            "fallback_models": [
                "nvidia/minimaxai/minimax-m3"
            ]
        },
        "unspecified-low": {
            "model": "openai/gpt-5.6-luna",
            "fallback_models": [
                "nvidia/moonshotai/kimi-k2.6"
            ]
        },
        "unspecified-high": {
            "model": "opencode-go/kimi-k2.7-code",
            "fallback_models": [
                "nvidia/moonshotai/kimi-k2.6"
            ]
        },
        "writing": {
            "model": "opencode-go/kimi-k2.7-code",
            "fallback_models": [
                "nvidia/minimaxai/minimax-m3"
            ]
        }
    },
    "background_task": {
        "defaultConcurrency": 5,
        "providerConcurrency": {
            "openai": 2,
            "opencode-go": 3,
            "nvidia": 2,
            "openrouter": 2
        },
        "modelConcurrency": {
            "opencode-go/kimi-k2.7-code": 1,
            "opencode-go/kimi-k3": 1
        }
    },
    "runtime_fallback": {
        "enabled": true,
        "retry_on_errors": [
            400,
            401,
            403,
            404,
            410,
            429,
            500,
            502,
            503,
            504
        ],
        "max_fallback_attempts": 4,
        "cooldown_seconds": 15,
        "timeout_seconds": 15,
        "notify_on_fallback": true
    },
    "telemetry": false
}
