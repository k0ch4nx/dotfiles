{
    "$schema": "https://raw.githubusercontent.com/cortexkit/magic-context/master/assets/magic-context.schema.json",
    "auto_update": false,
    "language": "ja",
    "historian": {
        "opencode": {
            "model": "opencode-go/beam-free"
        }
    },
    "dreamer": {
        "opencode": {
            "model": "opencode-go/beam-free"
        }
    },
    "memory": {
        "git_commit_indexing": {
            "enabled": true
        }
    }
}
