{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "servers": {
            "omni": {
                "type": "remote",
                "url": "http://127.0.0.1:51234/mcp",
                "oauth": false
            },
            "skillsmp": {
                "type": "local",
                "command": [
                    "npx",
                    "-y",
                    "skillsmp-mcp-lite"
                ],
                "env": {
                    "SKILLSMP_API_KEY": "{env:SKILLSMP_API_KEY}"
                }
            }
        }
    },
    "lsp": true,
    "permissions": [
        {
            "action": "*",
            "resource": "*",
            "effect": "allow"
        }
    ],
    "enabled_providers": [
        "google",
        "lmstudio",
        "nvidia",
        "openai",
        "opencode",
        "opencode-go"
    ],
    "plugins": [
        "oh-my-opencode-slim@latest",
        "@cortexkit/opencode-magic-context@latest"
    ],
    "compaction": {
        "auto": false
    }
}
