{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "servers": {
            "skillsmp": {
                "type": "local",
                "command": ["npx", "-y", "skillsmp-mcp-lite"],
                "env": {"SKILLSMP_API_KEY": "{env:SKILLSMP_API_KEY}"}
            }
        }
    },
    "lsp": true,
    "permissions": [{"action": "*", "resource": "*", "effect": "ask"}],
    "enabled_providers": ["google", "lm-studio", "openai", "opencode", "opencode-go"],
    "providers": {
        "lm-studio": {
            "name": "LMStudio",
            "package": "aisdk:@ai-sdk/openai-compatible",
            "settings": {"baseURL": "http://127.0.0.1:1234/v1"}
        }
    },
    "plugins": [
        "oh-my-opencode-slim@latest"
    ]
}
