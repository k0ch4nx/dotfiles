{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "skillsmp": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "skillsmp-mcp-lite"
            ],
            "env": {
                "SKILLSMP_API_KEY": "{env:SKILLSMP_API_KEY}"
            }
        }
    },
    "lsp": true,
    "permission": {
        "*": "ask"
    },
    "enabled_providers": [
        "google",
        "lm-studio",
        "openai",
        "opencode",
        "opencode-go"
    ],
    "provider": {
        "lm-studio": {
            "name": "LMStudio",
            "npm": "@ai-sdk/openai-compatible",
            "options": {
                "baseURL": "http://127.0.0.1:1234/v1"
            },
            "blacklist": [
                "openai/gpt-oss-20b",
                "qwen/qwen3-30b-a3b-2507",
                "qwen/qwen3-coder-30b"
            ]
        }
    },
    "plugin": [
        "@mem0/opencode-plugin",
        [
            "github:guochen-thlg/opencode-auto-provider-models",
            {
                "provider": [
                    "lm-studio"
                ]
            }
        ],
        "oh-my-opencode-slim@latest",
        "opencode-gemini-auth@latest"
    ]
}
