{
    "lsp": true,
    "plugins": [
        "github:Automattic/radical-pipelines"
    ],
    "mcp": {
        "servers": {
            "skillsmp": {
                "type": "local",
                "command": [
                    "npx",
                    "-y",
                    "skillsmp-mcp-lite"
                ],
                "environment": {
                    "SKILLSMP_API_KEY": "{env:SKILLSMP_API_KEY}"
                }
            }
        }
    },
    "permissions": [
        { "action": "*", "resource": "*", "effect": "ask" },
        { "action": "shell", "resource": "cat *", "effect": "allow" },
        { "action": "shell", "resource": "curl *", "effect": "allow" },
        { "action": "shell", "resource": "echo *", "effect": "allow" },
        { "action": "shell", "resource": "find *", "effect": "allow" },
        { "action": "shell", "resource": "grep *", "effect": "allow" },
        { "action": "shell", "resource": "head *", "effect": "allow" },
        { "action": "shell", "resource": "ls *", "effect": "allow" },
        { "action": "shell", "resource": "sleep *", "effect": "allow" },
        { "action": "shell", "resource": "wc *", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "list", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "allow" },
        { "action": "todoread", "resource": "*", "effect": "allow" },
        { "action": "todowrite", "resource": "*", "effect": "allow" },
        { "action": "context7_*", "resource": "*", "effect": "allow" },
        { "action": "playwright_*", "resource": "*", "effect": "allow" },
        { "action": "grep_app_searchGitHub", "resource": "*", "effect": "allow" },
        { "action": "skill", "resource": "*", "effect": "allow" }
    ],
    "providers": {
        "lm-studio": {
            "name": "LMStudio",
            "package": "aisdk:@ai-sdk/openai-compatible",
            "settings": {
                "baseURL": "http://127.0.0.1:1234/v1"
            },
            "models": {
                "openai/gpt-oss-20b": { "disabled": true },
                "qwen/qwen3-30b-a3b-2507": { "disabled": true },
                "qwen/qwen3-coder-30b": { "disabled": true }
            }
        }
    }
}
