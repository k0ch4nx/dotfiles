{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "skillsmp": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "skillsmp-mcp-lite"
            ],
            "env": {
                "SKILLSMP_API_KEY": "{env:SKILLSMP_API_KEY}"
            }
        }
    },
    "lsp": true,
    "permission": {
        "*": "ask",
        "bash": {
            "*": "ask",
            "cat *": "allow",
            "curl *": "allow",
            "echo *": "allow",
            "find *": "allow",
            "grep *": "allow",
            "head *": "allow",
            "ls *": "allow",
            "sleep *": "allow",
            "wc *": "allow"
        },
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "context7_query-docs": "allow",
        "context7_resolve-library-id": "allow",
        "playwright_*": "allow",
        "read": "allow",
        "todoread": "allow",
        "todowrite": "allow",
        "webfetch": "allow",
        "websearch_web_search_exa": "allow",
        "grep_app_searchGitHub": "allow",
        "skill": "allow"
    },
    "enabled_providers": [
        "lm-studio",
        "openai",
        "opencode-go",
    ],
    "provider": {
        "lm-studio": {
            "name": "LMStudio",
            "npm": "@ai-sdk/openai-compatible",
            "options": {
                "baseURL": "http://127.0.0.1:1234/v1",
            },
            "blacklist": [
                "openai/gpt-oss-20b",
                "qwen/qwen3-30b-a3b-2507",
                "qwen/qwen3-coder-30b",
            ]
        },
        "openai": {
            "whitelist": [
                "gpt-5.6-luna",
                "gpt-5.6-terra",
                "gpt-5.6-sol",
            ]
        },
        "opencode-go": {
            "whitelist": [
                "deepseek-v4-flash",
                "qwen3.7-plus",
                "deepseek-v4-pro",
                "kimi-k2.7-code",
                "kimi-k3",
            ],
        },
    },
    "plugin": [
        "@mem0/opencode-plugin",
        [
            "github:guochen-thlg/opencode-auto-provider-models",
            {
                "provider": [
                    "lm-studio"
                ]
            }
        ],
        "oh-my-opencode-slim@latest",
        "@tarquinen/opencode-dcp@latest",
        "opencode-vibeguard"
    ]
}
