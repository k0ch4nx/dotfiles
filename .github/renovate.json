{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        "helpers:pinGitHubActionDigests"
    ],
    "enabledManagers": [
        "github-actions"
    ],
    "prHourlyLimit": 1,
    "dependencyDashboard": false,
    "packageRules": [
        {
            "matchManagers": [
                "github-actions"
            ],
            "automerge": true,
            "platformAutomerge": true
        }
    ]
}
